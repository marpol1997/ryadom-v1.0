# ---- Postgres (Supabase или свой сервер) ----
# Supabase: Project Settings -> Database -> Connection string -> Transaction pooler
# (порт 6543). Для миграций и сидера удобнее прямое подключение (порт 5432).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Размер пула соединений. На serverless оставьте пустым (5), локально 3.
# DB_POOL_MAX=5

# ---- Хранилище фото (S3-совместимое) ----
# Supabase: Project Settings -> Storage -> S3 access keys
#   S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
#   S3_REGION=<регион проекта, например eu-central-1>
# Свой сервер: MinIO (http://minio:9000) или Cloudflare R2 / AWS S3.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=request-photos
# Публичная база для картинок:
#   Supabase: https://PROJECT_REF.supabase.co/storage/v1/object/public/request-photos
#   MinIO:    https://files.example.com/request-photos
S3_PUBLIC_URL=

# ---- Приложение ----
# Публичный адрес (для OG-тегов и корректных ссылок)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# development | production
NODE_ENV=development
