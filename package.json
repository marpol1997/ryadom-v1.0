{
  "name": "ryadom",
  "version": "2.0.0",
  "private": true,
  "description": "Рядом — Севастополь: чаты домов и СНТ, заявки, карта, специалисты и участковые",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "db:verify": "node scripts/verify-db.mjs",
    "db:local": "node scripts/dev-db.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:sql": "node scripts/seed.mjs --sql",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:next": "next dev",
    "smoke:local": "node scripts/smoke-local.mjs",
    "db:clean": "node scripts/cleanup.mjs",
    "db:reset-limits": "node scripts/reset-limits.mjs"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.38.4",
    "leaflet": "^1.9.4",
    "next": "^15.5.28",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@eslint/js": "^9.39.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "license": "MIT"
}
