{
  "name": "Рядом — Севастополь",
  "short_name": "Рядом",
  "description": "Чаты домов и СНТ, заявки с фото, карта города и проверенные специалисты Севастополя.",
  "lang": "ru",
  "dir": "ltr",
  "start_url": "/app",
  "scope": "/",
  "id": "/app",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#f6f7fd",
  "theme_color": "#4f46e5",
  "categories": ["social", "utilities", "lifestyle"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Новая заявка",
      "short_name": "Заявка",
      "url": "/app?action=request",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Чаты",
      "short_name": "Чаты",
      "url": "/app?screen=chats",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Карта города",
      "short_name": "Карта",
      "url": "/app?screen=map",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
